# 준비용 빈 템플릿. 실제 production에 이 파일을 일괄 업로드하지 않는다.
# 값은 소유권·앱·심사·콜백 확인 후 Secret 입력 경로에만 전달한다.
# Instagram 채널 OAuth (Facebook Login 방식)
META_APP_ID=
META_APP_SECRET=
# Google Business Profile 채널 OAuth. Gemini API 키가 아니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Naver 회원 로그인. 블로그·플레이스 게시 권한이 아니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 알림톡 실제 발송 서버용. 위임·발신프로필·템플릿 검증 별도.
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_PROFILE_KEY=
ALIGO_SENDER=
ALIMTALK_TEMPLATE_DAILY_BLOG=
ALIMTALK_TEMPLATE_REVIEW_ALERT=
ALIMTALK_TEMPLATE_REACTIVATE=
# Facebook 페이지 읽기 전용 연결 (게시 권한 미요청)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Threads 전용 App ID/Secret, threads_basic 읽기 전용
THREADS_APP_ID=
THREADS_APP_SECRET=
# Google/Kakao 회원 로그인 키는 운영 Supabase Providers에서 관리한다.
# Gemini 키는 보류 유지: 이 템플릿에 넣지 않는다.
