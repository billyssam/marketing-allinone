{
  "manifest_version": 3,
  "name": "마케팅올인원 — 원클릭 발행",
  "version": "0.5.0",
  "description": "매일 아침 준비된 글을 네이버 블로그·플레이스·밴드·당근·카카오채널·구글 비즈니스에 그대로 채워 넣습니다.",
  "permissions": ["storage", "activeTab", "tabs", "clipboardWrite", "clipboardRead"],
  "host_permissions": [
    "https://blog.naver.com/*",
    "https://*.blog.naver.com/*",
    "https://new.smartplace.naver.com/*",
    "https://smartplace.naver.com/*",
    "https://band.us/*",
    "https://www.daangn.com/*",
    "https://center-pf.kakao.com/*",
    "https://business.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://blog.naver.com/*",
        "https://*.blog.naver.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://new.smartplace.naver.com/*",
        "https://smartplace.naver.com/*",
        "https://band.us/*",
        "https://www.daangn.com/*",
        "https://center-pf.kakao.com/*",
        "https://business.google.com/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://marketing-allinone.vercel.app/*",
        "http://localhost:3500/*",
        "http://127.0.0.1:3500/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "원클릭 발행"
  },
  "externally_connectable": {
    "matches": [
      "https://marketing-allinone.vercel.app/*",
      "https://*.vercel.app/*",
      "http://localhost:3500/*",
      "http://127.0.0.1:3500/*"
    ]
  }
}
